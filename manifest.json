{
  "manifest_version": 3,
  "name": "SEO Change Guard",
  "version": "1.0.0",
  "description": "Capture and compare a page's SEO baseline locally. No data leaves your browser.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "SEO Change Guard"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
